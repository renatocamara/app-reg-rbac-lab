# Copy to .env and adjust. .env is gitignored — never commit real values.
export LAB_PREFIX="rbaclab"
export LAB_LOCATION="eastus2"
export LAB_RG="${LAB_PREFIX}-rg"
export LAB_APP_NAME="${LAB_PREFIX}-demo-app"
# Storage account names must be globally unique, lowercase, <=24 chars
export LAB_STORAGE="${LAB_PREFIX}st$RANDOM"
# Least-privilege data-plane role used in the lab
export LAB_ROLE="Storage Blob Data Reader"
